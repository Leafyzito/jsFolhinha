# Environment Configuration
ENV = "dev"

# Status service Configuration
STATUS_PORT = 3323

# Database Configuration
MONGO_URI = "mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# Turso is not used anymore
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optional Redis (set both REDIS_HOST and REDIS_PORT to enable; otherwise Redis is disabled)
REDIS_HOST = "localhost"
REDIS_PORT = "6379"

# ClickHouse (all five required when using ClickHouse; see src/clients/clickhouse/index.js)
CLICKHOUSE_HOST = "localhost"
CLICKHOUSE_PORT = "8123"
CLICKHOUSE_USERNAME = "default"
CLICKHOUSE_PASSWORD = "your-clickhouse-password"
CLICKHOUSE_DATABASE = "your-database-name"

# Developer Configuration
DEV_NICK = "your-nickname"
DEV_USERID = "your-user-id"
DEV_DISCORD_ID = "your-discord-id"
DEV_TEST_CHANNELS = "your-test-channel, your-test-channel2"
DEV_POSSIBLE_MENTIONS = "your,possible,mentions" #(ex: "leaf, leafy, leafyzito")
ADMIN_USERIDS = "your,admin,userids"

# Twitch Bot Configuration
# BOT_USERNAME + BOT_USERID: also used by `npm run init:mongo` to seed the first `config` row for the bot channel
BOT_USERNAME = "your-bot-username"
BOT_USERID = "your-bot-userid"
BOT_IRC_TOKEN = "oauth:your-irc-token"
BOT_CLIENT_ID = "your-client-id"
BOT_CLIENT_SECRET = "your-client-secret"
BOT_OAUTH_TOKEN = "your-oauth-token"
BOT_SCOPES = "your-bot-scopes"
BOT_7TV_UID = "your-bot-7tv-uid"

# Discord Configuration
DISCORD_TOKEN = "your-discord-token"
DISCORD_LOG_CHANNEL = "discord-channel-id-for-logs"
DISCORD_IMPORTANT_LOGS_CHANNEL = "discord-channel-id-for-important-logs"
DISCORD_LOG_WHISPER_CHANNEL = "discord-channel-id-for-whisper-logs"
DISCORD_DEV_MENTIONS_CHANNEL = "discord-channel-id-for-dev-mentions"

# API Keys
SHORTURL_CHUW_KEY = "your-shorturl-key"
FERIDINHA_API_KEY = "your-feridinha-key"
GOOGLE_SEARCH_API_KEY = "your-google-search-key"
GOOGLE_YOUTUBE_SEARCH_API_KEY = "your-google-youtube-search-key"
GOOGLE_SEARCH_ENGINE_ID = "your-search-engine-id"
GITHUB_GIST_TOKEN = "your-github-token"
OPENAI_API_KEY = "your-openai-key"
GEMINI_API_KEY = "your-gemini-api-key"
LASTFM_API_KEY = "your-lastfm-key"
LASTFM_SHARED_SECRET = "your-lastfm-secret"
OPEN_WEATHER_API_KEY = "your-weather-api-key"
TIMEZONEDB_KEY = "your-timezonedb-key"
WOLFRAM_API_KEY = "your-wolfram-key"
OMDB_API_KEY = "your-omdb-key"
LINEAR_API_KEY = "your-linear-api-key"
LINEAR_TEAM_ID = "your-linear-team-id"
LINEAR_LABEL_IDS = "optional-linear-label-id,another-label-id"
ISTHEREANYDEAL_API_KEY = "your-isthereanydeal-key"

# Webhook Configuration for the website, not used in this repository yet at least
WEBHOOK_URL="https://your-webhook-url.com"
WEBHOOK_SECRET="your-webhook-secret"

# API Keys for other services of the bot
RUSTLOG_API_KEY = "your-rustlog-key"
COBALT_API_KEY = "your-cobalt-key" 