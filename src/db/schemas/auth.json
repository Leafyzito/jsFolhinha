{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "auth",
  "description": "Twitch OAuth tokens for users that authorized the bot. One doc per Twitch user.",
  "bsonType": "object",
  "required": [
    "_id",
    "user_id",
    "access_token",
    "refresh_token",
    "expires_at",
    "token_type",
    "scope",
    "created_at",
    "is_valid",
    "failed_attempts"
  ],
  "properties": {
    "_id": { "bsonType": "objectId" },
    "user_id": {
      "bsonType": "string",
      "description": "Twitch user id of the authenticated user"
    },
    "username": { "bsonType": "string", "description": "Twitch login (lowercase)" },
    "display_name": { "bsonType": "string" },
    "profile_image_url": { "bsonType": "string" },
    "access_token": { "bsonType": "string" },
    "refresh_token": { "bsonType": "string" },
    "token_type": {
      "bsonType": "string",
      "description": "Always 'bearer' for Twitch"
    },
    "scope": {
      "bsonType": "array",
      "description": "Granted OAuth scopes",
      "items": { "bsonType": "string" }
    },
    "expires_at": { "bsonType": ["date", "string"] },
    "created_at": { "bsonType": ["date", "string"] },
    "last_used": { "bsonType": ["date", "string"] },
    "last_updated": { "bsonType": ["date", "string"] },
    "is_valid": {
      "bsonType": "bool",
      "description": "Flipped to false when refresh fails"
    },
    "failed_attempts": {
      "bsonType": ["int", "long"],
      "description": "Counter incremented on every failed token refresh"
    }
  }
}
