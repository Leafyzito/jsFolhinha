{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weather",
  "description": "Saved weather location per user, used by the !weather command.",
  "bsonType": "object",
  "required": ["_id", "userId", "location", "secret"],
  "properties": {
    "_id": { "bsonType": "objectId" },
    "userId": {
      "bsonType": "string",
      "description": "Twitch user id"
    },
    "location": {
      "bsonType": "string",
      "description": "Free-form location string (city, region, country, ...)"
    },
    "secret": {
      "bsonType": "bool",
      "description": "When true, the location is hidden from other users' weather lookups"
    }
  }
}
