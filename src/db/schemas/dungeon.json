{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dungeon",
  "description": "Per-user state for the dungeon minigame.",
  "bsonType": "object",
  "required": [
    "_id",
    "userId",
    "username",
    "xp",
    "level",
    "wins",
    "losses",
    "cooldown",
    "lastDungeon"
  ],
  "properties": {
    "_id": { "bsonType": "objectId" },
    "userId": { "bsonType": "string", "description": "Twitch user id" },
    "username": { "bsonType": "string", "description": "Twitch login at last play" },
    "xp": { "bsonType": ["int", "long"] },
    "level": { "bsonType": ["int", "long"] },
    "wins": { "bsonType": ["int", "long"] },
    "losses": { "bsonType": ["int", "long"] },
    "cooldown": {
      "bsonType": ["int", "long"],
      "description": "Current cooldown duration in seconds"
    },
    "lastDungeon": {
      "bsonType": ["int", "long", "double"],
      "description": "Unix seconds of last dungeon attempt"
    }
  }
}
