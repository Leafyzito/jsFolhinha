{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config",
  "description": "Per-channel bot configuration. One doc per channel the bot is in.",
  "bsonType": "object",
  "required": [
    "_id",
    "channel",
    "channelId",
    "prefix",
    "offlineOnly",
    "isPaused",
    "disabledCommands",
    "devBanCommands",
    "emoteStreak",
    "thankFollows",
    "thankSubs"
  ],
  "properties": {
    "_id": {
      "bsonType": "objectId"
    },
    "channel": {
      "bsonType": "string",
      "description": "Channel login (kept in sync on rename via user-update event)"
    },
    "channelId": {
      "bsonType": "string",
      "description": "Channel Twitch user id (immutable)"
    },
    "prefix": {
      "bsonType": "array",
      "minItems": 1,
      "items": {
        "bsonType": "string"
      },
      "description": "Command prefix character(s) the channel accepts, e.g. ['!'] or ['!', '?']"
    },
    "offlineOnly": {
      "bsonType": "bool",
      "description": "When true, the bot only responds while the stream is offline"
    },
    "isPaused": {
      "bsonType": "bool",
      "description": "Manually paused by a moderator"
    },
    "disabledCommands": {
      "bsonType": "array",
      "description": "Command names disabled by the broadcaster",
      "items": {
        "bsonType": "string"
      }
    },
    "devBanCommands": {
      "bsonType": "array",
      "description": "Command names disabled by a dev (overrides broadcaster)",
      "items": {
        "bsonType": "string"
      }
    },
    "commandSetting": {
      "bsonType": "object",
      "description": "Per-command tunables for this channel",
      "properties": {
        "maxPiramide": {
          "bsonType": ["int", "long"]
        }
      }
    },
    "emoteStreak": {
      "bsonType": "bool"
    },
    "thankFollows": {
      "bsonType": "bool"
    },
    "thankSubs": {
      "bsonType": "bool"
    },
    "botIsMod": {
      "bsonType": "bool"
    },
    "botIsVip": {
      "bsonType": "bool"
    },
    "state": {
      "bsonType": "string",
      "description": "Lifecycle state (e.g. 'active')"
    },
    "customMessages": {
      "bsonType": "object",
      "description": "Optional custom thank-you messages. Tokens supported: {user}, {emote}, {months}",
      "properties": {
        "follow": {
          "bsonType": "string"
        },
        "newSub": {
          "bsonType": "string"
        },
        "resub": {
          "bsonType": "string"
        }
      }
    }
  }
}